# Server Port Configuration
PORT=5000

# MongoDB Database Connection String
MONGO_URI=

# JWT Authentication Secret Key
JWT_SECRET=replace_with_a_long_random_jwt_secret_key

# Frontend Client URL (for CORS verification)
CLIENT_URL=http://127.0.0.1:5000

# OTP Delivery Mode (DEMO or LIVE)
OTP_MODE=DEMO

# KETAN AI Assistant Configuration (Google Gemini API)
# Obtain key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
