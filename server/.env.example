# Server Port Configuration (Render dynamically assigns PORT in cloud)
PORT=5000

# MongoDB Database Connection String (Local or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/fasalSetu

# JWT Authentication Secret Key
JWT_SECRET=your_jwt_secret_here

# Frontend Client URL (for CORS verification)
CLIENT_URL=*

# OTP Delivery Mode (DEMO or LIVE)
OTP_MODE=DEMO

# KETAN AI Assistant Configuration (Google Gemini API)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Python AI Microservice URL (Local or Deployed Render URL)
PYTHON_SERVICE_URL=http://localhost:8000

# IVR Feature Configuration
IVR_ENABLED=true
IVR_SESSION_TIMEOUT=1800
